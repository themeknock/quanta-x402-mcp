# ---- Database -------------------------------------------------------------
# Local dev (default): SQLite. Prod: Supabase / Postgres.
DATABASE_URL=sqlite+aiosqlite:///./quanta.db
# Supabase example:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ---- x402 payment settlement ---------------------------------------------
X402_ENABLED=true
# Public testnet facilitator (Base Sepolia). Free, no keys needed.
X402_FACILITATOR_URL=https://www.x402.org/facilitator
# Wallet that RECEIVES the micropayments (Base Sepolia):
X402_EVM_ADDRESS=0xYourBaseSepoliaAddress
# Price charged per data call:
X402_PRICE=$0.001
# Solana rail: OFF by default (public testnet facilitator settles EVM only).
# Turn on with a Solana-capable facilitator / Coinbase CDP, then set the address.
X402_ENABLE_SVM=false
X402_SVM_ADDRESS=YourSolanaDevnetAddress
# Mainnet settlement via Coinbase CDP (leave blank to stay on testnet):
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ---- App ------------------------------------------------------------------
APP_ENV=dev
PORT=4021
